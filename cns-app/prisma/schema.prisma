// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  ADMIN
  AUTHOR
  USER
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @default("NO_NAME")
  email         String    @unique(map: "user_email_idx")
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]

  role        Role         @default(USER)
  RelatedUser UserProfile? @relation("RelatedUser")

  Entry          Entry?              @relation(fields: [entryId], references: [id])
  entryId        Int?
  Map            Map?                @relation(fields: [mapId], references: [id])
  mapId          Int?
  MapHierarchy   MapHierarchyMaster? @relation(fields: [mapHierarchyId], references: [id])
  mapHierarchyId Int?
  Story          SubStory?              @relation(fields: [storyId], references: [id])
  storyId        Int?
  Wiki           Wiki?               @relation(fields: [wikiId], references: [id])
  wikiId         Int?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  slug      String?  @unique(map: "profile_slug_idx")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName        String  @unique @db.VarChar(255)
  profileCatch       String? @db.Text
  profileDescription String? @db.Text

  thumbnail String?

  UserId      String @unique
  RelatedUser User   @relation("RelatedUser", fields: [UserId], references: [id])

  @@index([UserId])
}

model Entry {
  id          Int      @id @default(autoincrement())
  slug        String?  @unique(map: "entry_slug_idx")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  imageUrl    String
  storyTime   Int      @default(0)

  category String?
  tags     String[]
  featured Boolean  @default(false)

  status          Status  @default(UPCOMING)
  authors         User[]
  stories         SubStory[]
  assignedToMapID Int?
  assignedToMap   Map?    @relation(fields: [assignedToMapID], references: [id])

  rating Int @default(0)

  @@index([assignedToMapID])
}

enum Status {
  COMPLETED
  ONGOING
  UPCOMING
}

// In the long term maps need to have parent-child maps to accommodate zoom levels and global maps
model Map {
  id          Int      @id @default(autoincrement())
  slug        String?  @unique(map: "map_slug_idx")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  imageUrl    String
  mapTime     Int
  mapUrl      String

  category String?
  tags     String[]
  featured Boolean  @default(false)

  assignedEntries Entry[]
  objects         GlobalObject[]
  area            GlobalArea[]
  authors         User[]

  parentInHierarchies MapHierarchyMaster[] @relation("ParentMap")
  childInHierarchies  MapHierarchyChild[]  @relation("ChildMap")
}

model MapHierarchyMaster {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String   @db.VarChar(255)

  parentMapId Int
  parentMap   Map                 @relation("ParentMap", fields: [parentMapId], references: [id])
  childMaps   MapHierarchyChild[]
  authors     User[]

  @@index([parentMapId])
}

model MapHierarchyChild {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hierarchyId Int
  hierarchy   MapHierarchyMaster @relation(fields: [hierarchyId], references: [id])
  childMapId  Int
  childMap    Map                @relation("ChildMap", fields: [childMapId], references: [id])

  x  Int @default(0)
  y  Int @default(0)
  wx Int @default(0)
  wy Int @default(0)

  @@unique([hierarchyId, childMapId])
  @@index([hierarchyId])
  @@index([childMapId])
}

model SubStory {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  nodes       Json[]
  objectTime  Int
  entry       Entry    @relation(fields: [entryId], references: [id])
  entryId     Int
  authors     User[]

  @@index([entryId])
}

model GlobalObject {
  id          Int           @id @default(autoincrement())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  title       String        @db.VarChar(255)
  description String        @db.Text
  imageUrl    String
  thumbUrl    String
  infobox     Json?
  x           Int
  y           Int
  objectTime  Int
  map         Map           @relation(fields: [mapId], references: [id])
  mapId       Int
  wiki        Wiki          @relation(fields: [wikiId], references: [id])
  wikiId      Int
  type        MapObjectType @default(LOCATION)

  @@index([mapId])
  @@index([wikiId])
}

model GlobalArea {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  title       String      @db.VarChar(255)
  description String      @db.Text
  imageUrl    String
  infobox     Json?
  nodes       Json?
  styles      Json?
  objectTime  Int
  map         Map         @relation(fields: [mapId], references: [id])
  mapId       Int
  wiki        Wiki        @relation(fields: [wikiId], references: [id])
  wikiId      Int
  type        MapAreaType @default(GEOGRAPHY)

  @@index([mapId])
  @@index([wikiId])
}

model Wiki {
  id          Int      @id @default(autoincrement())
  slug        String?  @unique(map: "wiki_slug_idx")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  thumbUrl    String   @default("")
  title       String   @db.VarChar(255)
  description String   @db.Text
  wikiText    String   @default("") @db.Text
  infobox     Json?

  category String?
  tags     String[]
  featured Boolean  @default(false)

  objects GlobalObject[]
  area    GlobalArea[]
  type    WikiType       @default(GENERAL)
  authors User[]
}

enum WikiType {
  GENERAL
  STORY
  AREA
  CHARACTER
  OBJECT
  HISTORY
  SCIENCE
  EXPLANATION
  OTHER
}

enum MapObjectType {
  LOCATION
  HISTORY
  NATURAL
  EVENT
}

enum MapAreaType {
  GEOGRAPHY
  ABSTRACT
  INTERACTIVE
}

