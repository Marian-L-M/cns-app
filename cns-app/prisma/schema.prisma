// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  role      Role     @default(USER)
  name      String?  @db.VarChar(255)
  username  String?  @unique @db.VarChar(255)
  image     String?  
  password  String
  likes     Entry[]
}

enum Role {
  ADMIN
  AUTHOR
  USER
}

model Entry {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String @db.VarChar(255)
  description String @db.Text
  imageUrl    String
  category    String
  rating      Int @default(0)
  storyTime   Int @default(0)
  status      Status @default(UPCOMING)
  users       User[]
  stories      Story[]
  assignedToMapID Int?
  assignedToMap Map? @relation(fields:[assignedToMapID], references: [id])

  @@index([assignedToMapID])
}

enum Status {
  COMPLETED
  ONGOING
  UPCOMING
}

model Map {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  imageUrl    String
  x           Int
  y           Int
  wx          Int
  wy          Int
  mapScale    Int
  mapTime     Int
  mapUrl      String
  assignedEntries       Entry[]
  objects     GlobalObject[]
  area        GlobalArea[]
}

model Story {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  nodes       Json?
  objectTime  Int
  entry         Entry      @relation(fields: [entryId], references: [id])
  entryId       Int

  @@index([entryId])
}

model GlobalObject {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  imageUrl    String
  thumbUrl    String
  infobox     Json?
  x           Int
  y           Int
  objectTime  Int
  map         Map      @relation(fields: [mapId], references: [id])
  mapId       Int
  wiki         Wiki      @relation(fields: [wikiId], references: [id])
  wikiId       Int
  type        MapObjectType @default(LOCATION)

  @@index([mapId])
  @@index([wikiId])
}

model GlobalArea {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String @db.Text
  imageUrl    String
  infobox     Json?
  nodes       Json?
  styles      Json?
  objectTime  Int
  map         Map      @relation(fields: [mapId], references: [id])
  mapId       Int
  wiki         Wiki      @relation(fields: [wikiId], references: [id])
  wikiId       Int
  type        MapAreaType @default(GEOGRAPHY)

  @@index([mapId])
  @@index([wikiId])
}

model Wiki {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String @db.Text
  infobox     Json?
  objects     GlobalObject[]
  area        GlobalArea[]
}

enum MapObjectType {
  LOCATION
  HISTORY
  NATURAL
  EVENT
}

enum MapAreaType {
  GEOGRAPHY
  ABSTRACT
  INTERACTIVE
}