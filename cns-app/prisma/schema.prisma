// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  role      Role     @default(USER)
  name      String?  @db.VarChar(255)
  username  String?  @unique @db.VarChar(255)
  image     String?  
  password  String
  likes     Entry[]
}

enum Role {
  ADMIN
  AUTHOR
  USER
}

model Entry {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String @db.VarChar(255)
  description String @db.Text
  imageUrl    String
  category    String
  rating      Int @default(0)
  storyTime   Int @default(0)
  status      Status @default(UPCOMING)
  users       User[]
  stories      Story[]
  assignedToMapID Int?
  assignedToMap Map? @relation(fields:[assignedToMapID], references: [id])

  @@index([assignedToMapID])
}

enum Status {
  COMPLETED
  ONGOING
  UPCOMING
}

// In the long term maps need to have parent-child maps to accommodate zoom levels and global maps
model Map {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  imageUrl    String

  mapTime     Int
  mapUrl      String
  assignedEntries       Entry[]
  objects     GlobalObject[]
  area        GlobalArea[]

  parentInHierarchies MapHierarchyMaster[] @relation("ParentMap")
  childInHierarchies  MapHierarchyChild[] @relation("ChildMap")
}

model MapHierarchyMaster {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255) 
  
  parentMapId Int
  parentMap   Map @relation("ParentMap", fields: [parentMapId], references: [id])
  childMaps    MapHierarchyChild[]
  
  @@index([parentMapId])
}

model MapHierarchyChild {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  hierarchyId Int
  hierarchy   MapHierarchyMaster @relation(fields: [hierarchyId], references: [id])
  childMapId  Int
  childMap    Map @relation("ChildMap", fields: [childMapId], references: [id])

  x           Int @default(0)
  y           Int @default(0)
  wx          Int @default(0)
  wy          Int @default(0)
  
  @@unique([hierarchyId, childMapId])
  @@index([hierarchyId])
  @@index([childMapId])
}

// 250131 Blew up database - Nodes needs to be a list of objects though
model Story {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  nodes       Json[]
  objectTime  Int
  entry         Entry      @relation(fields: [entryId], references: [id])
  entryId       Int

  @@index([entryId])
}

model GlobalObject {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String   @db.Text
  imageUrl    String
  thumbUrl    String
  infobox     Json?
  x           Int
  y           Int
  objectTime  Int
  map         Map      @relation(fields: [mapId], references: [id])
  mapId       Int
  wiki         Wiki      @relation(fields: [wikiId], references: [id])
  wikiId       Int
  type        MapObjectType @default(LOCATION)

  @@index([mapId])
  @@index([wikiId])
}

model GlobalArea {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String   @db.VarChar(255)
  description String @db.Text
  imageUrl    String
  infobox     Json?
  nodes       Json?
  styles      Json?
  objectTime  Int
  map         Map      @relation(fields: [mapId], references: [id])
  mapId       Int
  wiki         Wiki      @relation(fields: [wikiId], references: [id])
  wikiId       Int
  type        MapAreaType @default(GEOGRAPHY)

  @@index([mapId])
  @@index([wikiId])
}

model Wiki {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  featured    Boolean    @default(false)
  thumbUrl    String @default("")
  title       String   @db.VarChar(255)
  description String @db.Text
  wikiText    String @db.Text @default("")
  infobox     Json?
  objects     GlobalObject[]
  area        GlobalArea[]
  type        WikiType @default(GENERAL)
}

enum WikiType {
  GENERAL
  STORY
  AREA
  CHARACTER
  OBJECT
  HISTORY
  SCIENCE
  EXPLANATION
  OTHER
}

enum MapObjectType {
  LOCATION
  HISTORY
  NATURAL
  EVENT
}

enum MapAreaType {
  GEOGRAPHY
  ABSTRACT
  INTERACTIVE
}